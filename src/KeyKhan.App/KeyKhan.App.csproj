<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>KeyKhan</AssemblyName>
    <RootNamespace>KeyKhan.App</RootNamespace>
    <ApplicationIcon>Resources\keykhan.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      WPF0001: ThemeMode (Fluent theme) is marked experimental.
      WFO0003: WinForms analyzer; DPI awareness of this WPF app is declared in app.manifest.
    -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only NotifyIcon is taken from WinForms; keep its namespaces out of the global scope. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\keykhan.ico" />
    <Resource Include="Resources\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeyKhan.Vault\KeyKhan.Vault.csproj" />
  </ItemGroup>

</Project>

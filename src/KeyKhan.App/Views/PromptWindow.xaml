<Window x:Class="KeyKhan.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="LabelText" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="Input" />
        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="96" Content="Cancel" IsCancel="True" />
            <Button MinWidth="96" Margin="8,0,0,0" Content="OK" IsDefault="True"
                    Style="{StaticResource AccentButtonStyle}" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>

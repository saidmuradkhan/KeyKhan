<UserControl x:Class="KeyKhan.App.Views.LockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="/Resources/logo.png" Width="72" Height="72" />
            <TextBlock Margin="0,16,0,4" HorizontalAlignment="Center" Text="KeyKhan"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Subtitle}" />

            <StackPanel Visibility="{Binding IsRecovering, Converter={StaticResource BoolToVisible}}">
                <TextBlock Margin="0,24,0,4" Style="{StaticResource FieldLabel}" Text="Recovery key" />
                <TextBox x:Name="RecoveryKeyInput" FontFamily="{StaticResource MonoFont}" CharacterCasing="Upper"
                         Text="{Binding RecoveryKey, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Margin="0,16,0,4" Style="{StaticResource FieldLabel}" Text="{Binding PasswordLabel}" />
            <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />

            <StackPanel Visibility="{Binding IsChoosingPassword, Converter={StaticResource BoolToVisible}}">
                <ContentControl Margin="0,8,0,0" Focusable="False"
                                Content="{Binding Strength}" ContentTemplate="{StaticResource StrengthMeter}" />
                <TextBlock Margin="0,12,0,4" Style="{StaticResource FieldLabel}" Text="Confirm master password" />
                <PasswordBox x:Name="ConfirmInput" />
            </StackPanel>

            <TextBlock Margin="0,12,0,0" Style="{StaticResource ErrorText}" Text="{Binding Error}" />

            <Button Margin="0,20,0,0" HorizontalAlignment="Stretch" IsDefault="True"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="{Binding SubmitText}" Click="OnSubmit" />
            <ProgressBar Margin="0,12,0,0" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

            <Button Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource LinkButton}"
                    Content="Forgot your master password?" Command="{Binding ForgotPasswordCommand}"
                    Visibility="{Binding IsUnlocking, Converter={StaticResource BoolToVisible}}" />
            <Button Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource LinkButton}"
                    Content="Back to unlock" Command="{Binding BackToUnlockCommand}"
                    Visibility="{Binding IsRecovering, Converter={StaticResource BoolToVisible}}" />
        </StackPanel>
    </Grid>
</UserControl>

<Window x:Class="KeyKhan.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change master password"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource FieldLabel}" Text="Current master password" />
        <PasswordBox x:Name="CurrentInput" />

        <TextBlock Margin="0,16,0,4" Style="{StaticResource FieldLabel}" Text="New master password" />
        <PasswordBox x:Name="NewInput" PasswordChanged="OnNewPasswordChanged" />
        <ContentControl Margin="0,8,0,0" Focusable="False"
                        Content="{Binding Strength}" ContentTemplate="{StaticResource StrengthMeter}" />

        <TextBlock Margin="0,12,0,4" Style="{StaticResource FieldLabel}" Text="Confirm new master password" />
        <PasswordBox x:Name="ConfirmInput" />

        <TextBlock Margin="0,12,0,0" Style="{StaticResource ErrorText}" Text="{Binding Error}" />
        <ProgressBar Margin="0,12,0,0" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="96" Content="Cancel" IsCancel="True" />
            <Button MinWidth="96" Margin="8,0,0,0" Content="Change" IsDefault="True"
                    Style="{StaticResource AccentButtonStyle}" Click="OnSubmit" />
        </StackPanel>
    </StackPanel>
</Window>

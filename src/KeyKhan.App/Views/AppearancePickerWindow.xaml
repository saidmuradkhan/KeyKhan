<Window x:Class="KeyKhan.App.Views.AppearancePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="580" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal">
            <ContentControl Content="{Binding Preview}" ContentTemplate="{StaticResource EntryAvatar}" Focusable="False">
                <ContentControl.LayoutTransform>
                    <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                </ContentControl.LayoutTransform>
            </ContentControl>
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}"
                       Text="{Binding Preview.Title}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
        </StackPanel>

        <Grid Margin="0,20,0,8">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Icon" />
            <Button HorizontalAlignment="Right" Style="{StaticResource LinkButton}" Content="Use automatic"
                    Command="{Binding AutomaticIconCommand}" />
        </Grid>
        <Grid>
            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="Search icons"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}" />
        </Grid>
        <ListBox x:Name="IconList" Margin="0,8,0,0" Height="232" ItemsSource="{Binding Icons}"
                 SelectedItem="{Binding SelectedIcon, Mode=OneWay}" SelectionChanged="OnIconSelected"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="ToolTip" Value="{Binding Label}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Width="40" Height="40" Padding="0,10,0,0" TextAlignment="Center"
                               FontFamily="{StaticResource IconFont}" FontSize="18" Text="{Binding Glyph}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Margin="0,16,0,8">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Color" />
            <Button HorizontalAlignment="Right" Style="{StaticResource LinkButton}" Content="Use automatic"
                    Command="{Binding AutomaticColorCommand}" />
        </Grid>
        <ListBox ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Margin" Value="1" />
                    <Setter Property="ToolTip" Value="{Binding Label}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Ellipse Width="26" Height="26" Fill="{Binding Brush}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="96" Content="Cancel" IsCancel="True" />
            <Button MinWidth="96" Margin="8,0,0,0" Content="Save" IsDefault="True"
                    Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</Window>

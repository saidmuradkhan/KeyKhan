<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:KeyKhan.App.Converters"
                    xmlns:controls="clr-namespace:KeyKhan.App.Controls">

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    <conv:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
    <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
    <conv:EmptyToCollapsedConverter x:Key="EmptyToVisible" Invert="True" />
    <conv:InitialConverter x:Key="Initial" />
    <conv:AvatarBrushConverter x:Key="AvatarBrush" />
    <conv:IconGlyphConverter x:Key="IconGlyph" />
    <conv:ColorKeyBrushConverter x:Key="ColorKeyBrush" />
    <conv:EqualsParameterConverter x:Key="EqualsParameter" />
    <conv:StrengthBrushConverter x:Key="StrengthBrush" />
    <conv:StrengthTextConverter x:Key="StrengthText" />
    <conv:StrengthValueConverter x:Key="StrengthValue" />

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter RecognizesAccessKey="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource EmptyToCollapsed}}" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Rounded letter tile used as an entry icon. Bind DataContext to a VaultEntry. -->
    <!-- The entry's icon if it has one, otherwise its initial. -->
    <DataTemplate x:Key="EntryAvatar">
        <Border Width="32" Height="32" CornerRadius="6"
                Background="{Binding Converter={StaticResource AvatarBrush}}">
            <Grid>
                <TextBlock Text="{Binding Title, Converter={StaticResource Initial}}"
                           Foreground="White" FontWeight="SemiBold" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Text, ElementName=Glyph, Converter={StaticResource EmptyToVisible}}" />
                <TextBlock x:Name="Glyph" Text="{Binding Icon, Converter={StaticResource IconGlyph}}"
                           FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Five-step bar plus label. Bind DataContext to a StrengthLevel. -->
    <DataTemplate x:Key="StrengthMeter">
        <StackPanel Orientation="Horizontal">
            <ProgressBar Width="120" Height="4" Minimum="0" Maximum="5"
                         Value="{Binding Mode=OneWay, Converter={StaticResource StrengthValue}}"
                         Foreground="{Binding Converter={StaticResource StrengthBrush}}" />
            <TextBlock Margin="8,0,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Converter={StaticResource StrengthText}}" />
        </StackPanel>
    </DataTemplate>

    <!-- Implicit styles match the exact type, so subclasses must opt in to the Fluent look. -->
    <Style TargetType="controls:KeyComboBox" BasedOn="{StaticResource DefaultTextBoxStyle}" />

    <Style TargetType="controls:SecretBox">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SecretBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PART_PasswordBox"
                                     Visibility="{Binding IsRevealed, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToCollapsed}}" />
                        <TextBox FontFamily="{StaticResource MonoFont}"
                                 Text="{Binding Secret, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsRevealed, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisible}}" />
                        <ToggleButton Grid.Column="1" Margin="4,0,0,0" Padding="9" ToolTip="Show or hide"
                                      IsChecked="{Binding IsRevealed, RelativeSource={RelativeSource TemplatedParent}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="14" />
                        </ToggleButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

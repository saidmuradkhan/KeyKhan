<Application x:Class="KeyKhan.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KeyKhan.App.ViewModels"
             xmlns:views="clr-namespace:KeyKhan.App.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:LockViewModel}">
                <views:LockView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VaultViewModel}">
                <views:VaultView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

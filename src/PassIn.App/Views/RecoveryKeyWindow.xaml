<Window x:Class="PassIn.App.Views.RecoveryKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save your recovery key"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Your recovery key" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="If you forget your master password, this key is the only way to get back into your vault. It is shown only now — save it somewhere safe, away from this computer." />

        <Border Margin="0,20,0,0" Style="{StaticResource Card}" Padding="16,14">
            <TextBox Text="{Binding RecoveryKey, Mode=OneWay}" IsReadOnly="True" TextAlignment="Center"
                     FontFamily="{StaticResource MonoFont}" FontSize="18"
                     Background="Transparent" BorderThickness="0" Padding="0" />
        </Border>

        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
            <Button MinWidth="96" Command="{Binding CopyCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE8C8;" />
                    <TextBlock Margin="8,0,0,0" Text="Copy" />
                </StackPanel>
            </Button>
            <Button Margin="8,0,0,0" MinWidth="96" Command="{Binding SaveToFileCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE74E;" />
                    <TextBlock Margin="8,0,0,0" Text="Save to file…" />
                </StackPanel>
            </Button>
        </StackPanel>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Status}"
                   Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}" />

        <CheckBox Margin="0,20,0,0" Content="I have saved my recovery key somewhere safe" IsChecked="{Binding IsSaved}" />

        <Button Margin="0,20,0,0" MinWidth="120" HorizontalAlignment="Right" Content="Done" IsDefault="True"
                Style="{StaticResource AccentButtonStyle}" Command="{Binding DoneCommand}" />
    </StackPanel>
</Window>

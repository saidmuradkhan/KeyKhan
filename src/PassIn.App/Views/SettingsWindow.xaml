<Window x:Class="PassIn.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PassIn.App.Controls"
        Title="Settings"
        Width="600" Height="800" MinHeight="420" ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="ShortcutRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                <controls:KeyComboBox Grid.Column="1" Combo="{Binding Combo}" />
                <Button Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource IconButton}" Content="&#xE7A7;"
                        Command="{Binding ResetCommand}" ToolTip="Reset to default" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,16"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button MinWidth="96" Content="Cancel" IsCancel="True" />
                    <Button MinWidth="96" Margin="8,0,0,0" Content="Save" IsDefault="True"
                            Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}" />
                </StackPanel>
                <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource ErrorText}" Text="{Binding Error}" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,24">
                <TextBlock Style="{StaticResource SectionHeader}" Text="Quick access" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Global shortcut" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Click the box and press a new combination. Any Win + key works, except Win + L." />
                            </StackPanel>
                            <controls:KeyComboBox Grid.Column="1" Width="170" IsGlobal="True" VerticalAlignment="Center"
                                                  Combo="{Binding QuickAccessHotkey}"
                                                  GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur" />
                            <Button Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource IconButton}" Content="&#xE7A7;"
                                    Command="{Binding ResetHotkeyCommand}" ToolTip="Reset to Win + ~" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Keyboard shortcuts" />
                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6"
                            Style="{StaticResource LinkButton}" Content="Reset all" Command="{Binding ResetShortcutsCommand}" />
                </Grid>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Main window" />
                        <ItemsControl ItemsSource="{Binding MainShortcuts}" ItemTemplate="{StaticResource ShortcutRow}" Focusable="False" />
                        <TextBlock Margin="0,16,0,4" Style="{StaticResource FieldLabel}" Text="Quick access (↑ and ↓ always move through results)" />
                        <ItemsControl ItemsSource="{Binding QuickAccessShortcuts}" ItemTemplate="{StaticResource ShortcutRow}" Focusable="False" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Security" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Lock when idle" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AutoLockChoices}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding AutoLockMinutes}" />
                        <TextBlock Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center" Text="Clear copied passwords" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" ItemsSource="{Binding ClipboardChoices}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ClipboardClearSeconds}" />
                        <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                  Content="Lock when Windows is locked or goes to sleep" IsChecked="{Binding LockOnSessionLock}" />
                        <StackPanel x:Name="RememberDeviceOption" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
                            <Border Margin="0,0,0,10" Padding="12,10" CornerRadius="6"
                                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1"
                                    Visibility="{Binding ExplainsRememberDevice, Converter={StaticResource BoolToVisible}}">
                                <TextBlock TextWrapping="Wrap"
                                           Text="PassIn cannot stay locked while this is on: your Windows sign-in unlocks it again straight away. Turn it off and press Save to lock." />
                            </Border>
                            <CheckBox x:Name="RememberDeviceCheckBox" Content="Remember me on this computer" IsChecked="{Binding RememberDevice}"
                                      IsEnabled="{Binding CanManageVault, Mode=OneWay}" />
                            <TextBlock Margin="28,2,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="No master password on this computer: your Windows sign-in unlocks the vault. Anyone who can use your Windows account can open it." />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionHeader}" Text="General" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Content="Start with Windows (minimized to the tray)" IsChecked="{Binding StartWithWindows}" />
                        <CheckBox Margin="0,8,0,0" Content="Keep running in the tray when the window is closed"
                                  IsChecked="{Binding CloseToTray}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Theme" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding Theme}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Vault" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Vault file" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{Binding VaultPath}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding VaultPath}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource IconButton}" Content="&#xE838;"
                                    Command="{Binding ShowVaultFolderCommand}" ToolTip="Show in Explorer" />
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Margin="0,0,8,8" Content="Change master password…" Command="{Binding ChangeMasterPasswordCommand}" />
                            <Button Margin="0,0,8,8" Content="New recovery key…" Command="{Binding NewRecoveryKeyCommand}" />
                            <Button Margin="0,0,8,8" Content="Import from CSV…" Command="{Binding ImportCommand}" />
                            <Button Margin="0,0,8,8" Content="Export to CSV…" Command="{Binding ExportCommand}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Import understands CSV exports from Chrome, Edge, Firefox, Bitwarden, LastPass, 1Password and KeePass." />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Updates" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock VerticalAlignment="Center" Text="{Binding VersionText}" />
                            <Button HorizontalAlignment="Right" Content="Check now" Command="{Binding CheckForUpdatesNowCommand}" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding UpdateStatus}"
                                   Visibility="{Binding UpdateStatus, Converter={StaticResource EmptyToCollapsed}}" />
                        <CheckBox Margin="0,12,0,0" Content="Check for updates automatically" IsChecked="{Binding CheckForUpdates}" />
                        <TextBlock Margin="28,2,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Asks GitHub for the latest release every few hours and when you open PassIn. Nothing about you or your vault is sent." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
